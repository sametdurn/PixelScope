{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.0.1",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "minimum_chrome_version": "111",
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'none'" },
  "permissions": ["activeTab", "scripting", "downloads", "contextMenus", "storage", "clipboardWrite"],
  "host_permissions": ["<all_urls>"],
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_extName__",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "background": { "service_worker": "background.js"},
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content-main.js"], "run_at": "document_start", "all_frames": true, "world": "MAIN" },
    { "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start", "all_frames": true }
  ]
}
